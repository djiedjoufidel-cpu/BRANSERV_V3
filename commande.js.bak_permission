const BRANSERV_SUPABASE_URL =
  "https://lsaykyehbfgfpoqwsmto.supabase.co";

const BRANSERV_SUPABASE_KEY =
  "sb_publishable_nuAzQtyhEtTeQoC-4JjM3g_yGG7KHdZ";

const ORDERS_KEY = "brans_orders";

let branservSupabase = null;

/* ------------------------------------------------------------
   Supabase
------------------------------------------------------------ */
function getBranservSupabase() {
  if (!window.supabase) {
    throw new Error("Le SDK Supabase n'est pas chargé.");
  }

  if (!branservSupabase) {
    branservSupabase = window.supabase.createClient(
      BRANSERV_SUPABASE_URL,
      BRANSERV_SUPABASE_KEY
    );
  }

  return branservSupabase;
}

/* ------------------------------------------------------------
   Résumé commande
------------------------------------------------------------ */
function renderOrderSummary() {

  const box = document.getElementById("orderSummary");

  if (!box) return;

  const cart = getCart();
  const products = getProducts();

  let total = 0;

  cart.forEach(item => {

    const product = products.find(
      p => String(p.id) === String(item.id)
    );

    if (product) {
      total +=
        Number(product.price || 0) *
        Number(item.quantity || 0);
    }

  });

  box.innerHTML = `
    <div class="summary">
      <h3>Résumé</h3>
      <p>
        Articles :
        ${cart.reduce(
          (sum, item) =>
            sum + Number(item.quantity || 0),
          0
        )}
      </p>
      <p>
        <strong>Total : ${money(total)}</strong>
      </p>
    </div>
  `;
}

/* ------------------------------------------------------------
   Sauvegarde locale de secours
------------------------------------------------------------ */
function getLocalOrders() {

  try {

    const data =
      localStorage.getItem(ORDERS_KEY);

    if (!data) return [];

    const orders = JSON.parse(data);

    return Array.isArray(orders)
      ? orders
      : [];

  } catch (error) {

    console.error(
      "Erreur lecture commandes locales :",
      error
    );

    return [];
  }
}

function saveLocalOrder(order) {

  const orders = getLocalOrders();

  orders.push(order);

  localStorage.setItem(
    ORDERS_KEY,
    JSON.stringify(orders)
  );
}

/* ------------------------------------------------------------
   Client : retrouver ou créer
------------------------------------------------------------ */
async function getOrCreateCustomer({name, phone, email, address}) {
  const supabase = getBranservSupabase();

  // Pour un visiteur non connecté, on ne fait PAS de SELECT sur customers.
  // La politique Supabase autorise INSERT pour anon.
  const { data, error } = await supabase
    .from("customers")
    .insert({
      name: name,
      phone: phone,
      email: email || null,
      address: address || null
    })
    .select()
    .single();

  if (error) {
    console.error("Erreur création client :", error);
    throw new Error("Impossible d'enregistrer le client : " + error.message);
  }

  return data;
}

async function createSupabaseOrder({
  customer,
  items,
  subtotal,
  deliveryFee,
  total
}) {

  const supabase =
    getBranservSupabase();

  /* Création de la commande */
  const { data: order, error: orderError } =
    await supabase
      .from("orders")
      .insert({
        customer_id: customer.id,
        customer_name: customer.name,
        customer_phone: customer.phone,
        customer_address: customer.address || null,
        status: "new",
        total: total,
        cost_total: 0,
        profit: 0,
        invoice: false
      })
      .select()
      .single();

  if (orderError) {

    throw new Error(
      "Impossible de créer la commande : " +
      orderError.message
    );
  }

  /* Création des lignes */
  const orderItems = items.map(item => ({
    order_id: order.id,
    product_id: Number(item.productId),
    product_name: item.productName,
    quantity: Number(item.quantity),
    unit_price: Number(item.unitPrice),
    purchase_price: 0,
    total: Number(item.lineTotal)
  }));

  const { error: itemsError } =
    await supabase
      .from("order_items")
      .insert(orderItems);

  if (itemsError) {

    /* On tente de supprimer la commande
       si ses lignes n'ont pas pu être créées. */
    await supabase
      .from("orders")
      .delete()
      .eq("id", order.id);

    throw new Error(
      "Impossible d'enregistrer les produits : " +
      itemsError.message
    );
  }

  return order;
}

/* ------------------------------------------------------------
   Création commande
------------------------------------------------------------ */
async function submitOrder() {

  const cart = getCart();

  if (!cart.length) {
    alert("Votre panier est vide.");
    return;
  }

  const name =
    document
      .getElementById("customerName")
      .value
      .trim();

  const phone =
    document
      .getElementById("customerPhone")
      .value
      .trim();

  if (!name || !phone) {

    alert(
      "Veuillez renseigner votre nom et votre téléphone."
    );

    return;
  }

  const products = getProducts();

  const items = [];

  let subtotal = 0;

  /* Vérification produits + stock */
  for (const cartItem of cart) {

    const product =
      products.find(
        p =>
          String(p.id) ===
          String(cartItem.id)
      );

    if (!product) {

      alert(
        "Un produit n'existe plus."
      );

      return;
    }

    const quantity =
      Number(cartItem.quantity || 0);

    const stock =
      Number(product.stock || 0);

    if (quantity <= 0) {

      alert(
        "Quantité invalide pour : " +
        product.name
      );

      return;
    }

    if (quantity > stock) {

      alert(
        "Stock insuffisant pour : " +
        product.name +
        "\nStock disponible : " +
        stock
      );

      return;
    }

    const lineTotal =
      Number(product.price || 0) *
      quantity;

    items.push({
      productId: product.id,
      productName: product.name,
      quantity: quantity,
      unitPrice: Number(product.price || 0),
      lineTotal: lineTotal
    });

    subtotal += lineTotal;
  }

  const delivery =
    document
      .getElementById("delivery")
      ?.value || "";

  const comment =
    document
      .getElementById("comment")
      ?.value
      ?.trim() || "";

  const city =
    document
      .getElementById("city")
      ?.value
      ?.trim() || "";

  const district =
    document
      .getElementById("district")
      ?.value
      ?.trim() || "";

  const address =
    document
      .getElementById("address")
      ?.value
      ?.trim() || "";

  const fullAddress =
    [address, district, city]
      .filter(Boolean)
      .join(", ");

  const deliveryFee = 0;

  const total =
    subtotal + deliveryFee;

  try {

    /* --------------------------------------------------------
       1. Supabase
    -------------------------------------------------------- */

    console.log(
      "☁️ Enregistrement client..."
    );

    const customer =
      await getOrCreateCustomer({
        name,
        phone,
        email: "",
        address: fullAddress
      });

    console.log(
      "✅ Client Supabase :",
      customer.id
    );

    console.log(
      "☁️ Enregistrement commande..."
    );

    const supabaseOrder =
      await createSupabaseOrder({
        customer,
        items,
        subtotal,
        deliveryFee,
        total
      });

    console.log(
      "✅ Commande Supabase :",
      supabaseOrder.id
    );

    /* --------------------------------------------------------
       2. Commande locale compatible avec l'admin actuel
    -------------------------------------------------------- */

    const orderNumber =
      "BR-" +
      new Date().getFullYear() +
      "-" +
      String(supabaseOrder.id)
        .padStart(6, "0");

    const order = {

      /* IMPORTANT :
         ID = ID Supabase */
      id: supabaseOrder.id,

      orderNumber,

      createdAt:
        supabaseOrder.created_at ||
        new Date().toISOString(),

      customer: {
        name: name,
        phone: phone,
        city: city,
        district: district,
        address: address
      },

      delivery,

      comment,

      items,

      subtotal,

      deliveryFee,

      total,

      status: "new",

      invoice: false,

      supabaseId:
        supabaseOrder.id,

      customerId:
        customer.id
    };

    saveLocalOrder(order);

    /* --------------------------------------------------------
       3. WhatsApp
    -------------------------------------------------------- */

    let message =
      "Bonjour BRANSERV 👋\n\n" +
      "Nouvelle commande : " +
      orderNumber +
      "\n\n" +
      "Client : " +
      name +
      "\n" +
      "Téléphone : " +
      phone +
      "\n";

    items.forEach(item => {

      message +=
        "- " +
        item.productName +
        " x" +
        item.quantity +
        " = " +
        money(item.lineTotal) +
        "\n";

    });

    message +=
      "\nTotal : " +
      money(total) +
      "\nStatut : Nouvelle";

    if (delivery) {
      message +=
        "\nLivraison : " +
        delivery;
    }

    if (fullAddress) {
      message +=
        "\nAdresse : " +
        fullAddress;
    }

    if (comment) {
      message +=
        "\nCommentaire : " +
        comment;
    }

    localStorage.removeItem(
      "branserv_cart"
    );

    alert(
      "✅ Commande enregistrée !\n\n" +
      "Numéro : " +
      orderNumber +
      "\n\n" +
      "La commande est maintenant enregistrée dans BRANSERV."
    );

    window.location.href =
      "https://wa.me/" +
      WHATSAPP +
      "?text=" +
      encodeURIComponent(message);

  } catch (error) {

    console.error(
      "❌ ERREUR COMMANDE :",
      error
    );

    alert(
      "❌ La commande n'a pas pu être enregistrée.\n\n" +
      error.message
    );
  }
}

